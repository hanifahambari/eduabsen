# EduAbsen Environment Variables
# Copy this file to .env.local and fill in your values

# Supabase Configuration (Required)
# Get these from your Supabase project settings: https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-side Supabase (for Vercel API routes)
# Get these from your Supabase project settings: https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Recommended: dedicated secret for signing server-side API sessions (minimum 32 characters).
# Falls back to SUPABASE_SERVICE_ROLE_KEY when omitted.
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Optional: App Configuration
VITE_APP_NAME=EduAbsen
VITE_APP_VERSION=1.0.0

# Optional: Analytics (if using)
# VITE_GA_ID=G-XXXXXXXXXX